<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_bolt" />

    <TextView
        android:id="@+id/ovScrolls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="0 sc"
        android:textColor="#6FE7C7"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ovReels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="0 rl"
        android:textColor="#B49BFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ovClicks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="👆 0"
        android:textColor="#FFD54F"
        android:textSize="15sp"
        android:textStyle="bold" />

    <View
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:background="#3B3357" />

    <TextView
        android:id="@+id/ovTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="00:00"
        android:textColor="#EDEAF6"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ovFatigue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="🧠 0%"
        android:textColor="#A79EE0"
        android:textSize="13sp" />

    <View
        android:id="@+id/ovDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="10dp" />
</LinearLayout>